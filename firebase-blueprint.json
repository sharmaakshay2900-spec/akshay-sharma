{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile representation in Firestore",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email", "createdAt"]
    },
    "SavedReport": {
      "title": "SavedReport",
      "description": "Clinical patient evaluation report generated by Health Analyzer",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "patientName": { "type": "string", "maxLength": 128 },
        "age": { "type": "number" },
        "gender": { "type": "string", "maxLength": 32 },
        "symptoms": { "type": "string", "maxLength": 2048 },
        "vitals": { "type": "string", "maxLength": 1024 },
        "diagnosis": { "type": "string", "maxLength": 1024 },
        "recommendations": { "type": "string", "maxLength": 4096 },
        "doctorNotes": { "type": "string", "maxLength": 4096 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "patientName", "title", "createdAt"]
    },
    "SymptomCheck": {
      "title": "SymptomCheck",
      "description": "Record of a clinical symptom evaluation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "symptoms": { "type": "array" },
        "bodyArea": { "type": "string", "maxLength": 64 },
        "duration": { "type": "string", "maxLength": 64 },
        "severity": { "type": "string", "maxLength": 64 },
        "topCondition": { "type": "string", "maxLength": 128 },
        "topConfidence": { "type": "number" },
        "doctorSpecialty": { "type": "string", "maxLength": 128 },
        "urgencyGuidance": { "type": "string", "maxLength": 512 },
        "clinicalExplanation": { "type": "string", "maxLength": 4096 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "topCondition", "createdAt"]
    },
    "MCQResult": {
      "title": "MCQResult",
      "description": "User score and result record for medical quiz practice",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "score": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "percentage": { "type": "number" },
        "category": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "score", "totalQuestions", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Private user profile documents"
    },
    "/reports/{reportId}": {
      "schema": "SavedReport",
      "description": "Clinical evaluation reports created by users"
    },
    "/symptom_history/{historyId}": {
      "schema": "SymptomCheck",
      "description": "History records of symptom assessments"
    },
    "/mcq_results/{resultId}": {
      "schema": "MCQResult",
      "description": "Medical quiz score entries"
    }
  }
}
